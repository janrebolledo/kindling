{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kindling-web",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "kv_namespaces": [
    { "binding": "SESSION" }
  ]
}
