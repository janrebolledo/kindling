{
  // Source of truth for local `cd web && wrangler …` and Workers Builds
  // with Root directory `web`. Do not point this Worker at the repo root:
  // the root wrangler.jsonc is named kindling-api.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kindling-web",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
    // Share pages are SSR; browser navigations skip the Worker otherwise.
    "run_worker_first": ["/s/*"]
  },
  "services": [
    {
      "binding": "API",
      "service": "kindling-api",
      "remote": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "kv_namespaces": [
    { "binding": "SESSION" }
  ]
}
