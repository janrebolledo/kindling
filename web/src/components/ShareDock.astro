---
import DownloadButton from './DownloadButton.astro';

interface Props {
  label?: string;
}

const { label = 'download kindling on \uF8FF iPhone' } = Astro.props;
---

<div
  class="pointer-events-none fixed inset-x-0 bottom-0 z-10 mx-auto w-full max-w-[402px]"
>
  <div class="share-dock-blur" aria-hidden="true">
    <div></div>
    <div></div>
    <div></div>
    <div></div>
    <div></div>
    <div></div>
  </div>
  <div class="share-dock-fill" aria-hidden="true"></div>
  <div
    class="relative flex justify-center pt-20 pb-[max(2.5rem,calc(1.5rem+env(safe-area-inset-bottom,0px)))]"
  >
    <div class="pointer-events-auto">
      <DownloadButton {label} />
    </div>
  </div>
</div>

<style>
  .share-dock-blur,
  .share-dock-fill {
    position: absolute;
    inset: 0;
  }

  .share-dock-blur > div {
    position: absolute;
    inset: 0;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  .share-dock-blur > div:nth-child(1) {
    -webkit-backdrop-filter: blur(0.5px);
    backdrop-filter: blur(0.5px);
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 12.5%,
      #000 25%,
      transparent 37.5%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 12.5%,
      #000 25%,
      transparent 37.5%
    );
  }

  .share-dock-blur > div:nth-child(2) {
    -webkit-backdrop-filter: blur(1px);
    backdrop-filter: blur(1px);
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 12.5%,
      #000 25%,
      #000 37.5%,
      transparent 50%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 12.5%,
      #000 25%,
      #000 37.5%,
      transparent 50%
    );
  }

  .share-dock-blur > div:nth-child(3) {
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 25%,
      #000 37.5%,
      #000 50%,
      transparent 62.5%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 25%,
      #000 37.5%,
      #000 50%,
      transparent 62.5%
    );
  }

  .share-dock-blur > div:nth-child(4) {
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 37.5%,
      #000 50%,
      #000 62.5%,
      transparent 75%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 37.5%,
      #000 50%,
      #000 62.5%,
      transparent 75%
    );
  }

  .share-dock-blur > div:nth-child(5) {
    -webkit-backdrop-filter: blur(5px);
    backdrop-filter: blur(5px);
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 50%,
      #000 62.5%,
      #000 75%,
      transparent 87.5%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 50%,
      #000 62.5%,
      #000 75%,
      transparent 87.5%
    );
  }

  .share-dock-blur > div:nth-child(6) {
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 62.5%,
      #000 75%,
      #000 100%
    );
    mask-image: linear-gradient(to bottom, transparent 62.5%, #000 75%, #000 100%);
  }

  .share-dock-fill {
    background: linear-gradient(
      to bottom,
      rgb(255 255 255 / 0) 0%,
      rgb(255 255 255 / 0.45) 45%,
      rgb(255 255 255 / 1) 82%
    );
  }

  @media (prefers-reduced-transparency: reduce) {
    .share-dock-blur {
      display: none;
    }

    .share-dock-fill {
      background: #fff;
    }
  }

  @supports not (
    (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))
  ) {
    .share-dock-blur {
      display: none;
    }
  }
</style>
