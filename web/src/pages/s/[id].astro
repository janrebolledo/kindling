---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import DownloadButton from '../../components/DownloadButton.astro';
import ShareDock from '../../components/ShareDock.astro';
import Footer from '../../components/Footer.astro';
import { fetchSharedIdea } from '../../lib/api';
import { formatSavedOn, resolvePlaceStatus } from '../../lib/openStatus';

const id = Astro.params.id ?? '';
const idea = await fetchSharedIdea(Astro.locals.runtime.env.API, id);

if (!idea) {
  Astro.response.status = 404;
}

const venue = idea?.place?.name ?? idea?.name ?? 'Untitled';
const title = idea ? `${venue} · kindling` : 'kindling';
const description = idea?.description || 'saved with kindling.';
const googlePhotoUrl = idea?.place?.photoUrl ?? null;
const mediaUrl = googlePhotoUrl ?? idea?.media_url;
const placeStatus = idea?.place
  ? resolvePlaceStatus(idea.place.weekdayDescriptions, idea.place.openNow)
  : null;
const priceLevel = idea?.place?.priceLevel === 'PRICE_LEVEL_FREE'
  ? 'Free'
  : idea?.place?.priceLevel === 'PRICE_LEVEL_INEXPENSIVE'
    ? '$'
    : idea?.place?.priceLevel === 'PRICE_LEVEL_MODERATE'
      ? '$$'
      : idea?.place?.priceLevel === 'PRICE_LEVEL_EXPENSIVE'
        ? '$$$'
        : idea?.place?.priceLevel === 'PRICE_LEVEL_VERY_EXPENSIVE'
          ? '$$$$'
          : null;
const activityDetails = idea
  ? [
      idea.distance_miles != null
        ? `${Number.isInteger(idea.distance_miles) ? idea.distance_miles : idea.distance_miles.toFixed(1)} mi`
        : null,
      idea.completion_time,
      idea.completion_time ? null : idea.duration,
    ].filter(Boolean).join(' · ')
  : null;
const googlePlace = idea?.place ?? null;
const hasCoordinates = Boolean(
  googlePlace?.latitude != null && googlePlace.longitude != null,
);
const googleMapsUrl = googlePlace?.googleMapsUri
  ?? (googlePlace?.id
    ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(venue)}&query_place_id=${encodeURIComponent(googlePlace.id)}`
    : null);
const mapEmbedUrl = hasCoordinates
  ? `https://www.google.com/maps?q=${encodeURIComponent(`${googlePlace?.latitude},${googlePlace?.longitude}`)}&z=15&output=embed`
  : null;
---

<Layout title={title} description={description} image={mediaUrl}>
  {
    !idea ? (
      <div class='flex min-h-dvh flex-col items-center justify-center px-6 text-center'>
        <p class='text-[32px] font-medium tracking-[-0.8px]'>
          this one’s gone.
        </p>
        <p class='mt-2 text-[16px] tracking-[-0.4px] text-muted'>
          the link may be old, or the place was never saved.
        </p>
        <div class='mt-8'>
          <DownloadButton label={'download kindling on \uF8FF iPhone'} />
        </div>
        <div class='mt-16 w-full'>
          <Footer variant='share' />
        </div>
      </div>
    ) : (
      <div class='mx-auto flex min-h-dvh w-full max-w-[402px] flex-col bg-white'>
        <div class='relative h-[487px] w-full overflow-hidden'>
          {mediaUrl ? (
            <img
              src={mediaUrl}
              alt={`${venue} photo`}
              data-fallback-src={googlePhotoUrl && idea.media_url ? idea.media_url : undefined}
              onerror="if (this.dataset.fallbackSrc && this.src !== this.dataset.fallbackSrc) { this.src = this.dataset.fallbackSrc; } else { this.hidden = true; }"
              width={804}
              height={974}
              class='absolute inset-0 size-full object-cover'
            />
          ) : (
            <div class='absolute inset-0 bg-linear-to-b from-[#f4e6d4] to-white' />
          )}
          <div
            class='pointer-events-none absolute inset-0'
            style='background-image: linear-gradient(to right, #fff 0%, transparent 20%, transparent 80%, #fff 100%), linear-gradient(to top, #fff 0%, transparent 52%);'
          />
          {googlePhotoUrl && googlePlace?.photoAttributions.length ? (
            <p class='absolute bottom-3 right-3 max-w-[70%] text-right text-[10px] leading-tight text-black/55'>
              Photo:{' '}
              {googlePlace.photoAttributions.map((attribution, index) => {
                const href = googlePlace.photoAttributionUrls?.[index];
                return href ? (
                  <a href={href} target='_blank' rel='noreferrer' class='underline'>
                    {attribution}
                  </a>
                ) : (
                  <span>{attribution}</span>
                );
              })}
            </p>
          ) : null}
        </div>

        <div class='flex flex-col gap-2 overflow-hidden px-2 py-2'>
          <h1 class='text-[32px] font-medium tracking-[-0.8px] text-black'>
            {venue}
          </h1>
          {(activityDetails || placeStatus || priceLevel || idea.location_type || idea.location_emoji || idea.duration) && (
            <div class='flex items-center gap-2 text-[16px] tracking-[-0.4px] text-muted'>
              {activityDetails ? (
                <span>{activityDetails}</span>
              ) : placeStatus ? (
                placeStatus.detail.startsWith('Opens') ? (
                  <span>{placeStatus.detail}</span>
                ) : (
                  <>
                    <span class='font-medium'>{placeStatus.isOpen ? 'Open' : 'Closed'}</span>
                    <span>{placeStatus.detail}</span>
                  </>
                )
              ) : (idea.location_emoji || idea.location_type) ? (
                <span class='font-medium'>
                  {[idea.location_emoji, idea.location_type]
                    .filter(Boolean)
                    .join(' ')}
                </span>
              ) : null}
              {!placeStatus && !activityDetails && idea.duration && <span>{idea.duration}</span>}
              {priceLevel && <span>{priceLevel}</span>}
            </div>
          )}
        </div>

        {(idea.name || idea.description) && (
          <div class='mx-4 mt-2 flex flex-col gap-2.5 rounded-xl bg-surface px-2 py-2.5'>
            <p class='text-[14px] font-medium tracking-[-0.35px] text-muted'>
              highlights
            </p>
            {idea.name && (
              <p class='text-[16px] font-medium tracking-[-0.4px] text-black'>
                {idea.name}
              </p>
            )}
            {idea.description && (
              <p class='text-[14px] font-medium tracking-[-0.35px] text-muted'>
                {idea.description}
              </p>
            )}
          </div>
        )}

        {idea.place?.weekdayDescriptions.length && !activityDetails ? (
          <div class='mx-4 mt-8 flex flex-col gap-3 px-2'>
            <p class='text-[14px] font-medium tracking-[-0.35px] text-muted'>hours</p>
            <div class='flex flex-col gap-3'>
              {idea.place.weekdayDescriptions.map((row) => {
                const [day, ...hours] = row.split(':');
                return (
                  <div class='flex items-start text-[16px] tracking-[-0.4px]'>
                    <span class='w-[127px] shrink-0 text-black'>{day}</span>
                    <span class='text-muted'>{hours.join(':').trim()}</span>
                  </div>
                );
              })}
            </div>
          </div>
        ) : null}

        {googleMapsUrl ? (
          <div class='mx-[13px] mt-8 overflow-hidden rounded-3xl'>
            {mapEmbedUrl ? (
              <div class='relative h-[203px]'>
                <iframe
                  title={`Google Maps location for ${venue}`}
                  src={mapEmbedUrl}
                  loading='lazy'
                  referrerpolicy='no-referrer-when-downgrade'
                  class='absolute inset-0 size-full border-0'
                />
                <a
                  href={googleMapsUrl}
                  target='_blank'
                  rel='noreferrer'
                  class='absolute right-4 top-4 rounded-full bg-black/25 px-3 py-2 text-[16px] font-medium text-white backdrop-blur-sm'
                >
                  open in Maps ↗
                </a>
              </div>
            ) : (
              <a
                href={googleMapsUrl}
                target='_blank'
                rel='noreferrer'
                class='flex h-[203px] items-end bg-[linear-gradient(135deg,#e8f0e8,#c8d9c8)] p-4 text-[16px] font-medium text-black'
              >
                view this place on Google Maps ↗
              </a>
            )}
            {googlePlace?.formattedAddress && (
              <a
                href={googleMapsUrl}
                target='_blank'
                rel='noreferrer'
                class='block bg-surface px-3 py-2 text-[14px] font-medium tracking-[-0.35px] text-muted'
              >
                {googlePlace.formattedAddress}
              </a>
            )}
          </div>
        ) : null}

        <div class='mt-8 flex flex-col items-center gap-1.5 px-4 text-center text-[16px] tracking-[-0.4px]'>
          <p class='text-muted'>Saved on</p>
          <p class='font-medium text-black'>{formatSavedOn(idea.created_at)}</p>
        </div>

        <div class='mt-auto px-[21px] pt-16 pb-40'>
          <Footer variant='share' />
        </div>

        <ShareDock label={'download kindling on \uF8FF iPhone'} />
      </div>
    )
  }
</Layout>
