---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import DownloadButton from '../components/DownloadButton.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="not found · kindling">
  <div class="flex min-h-dvh flex-col items-center justify-center px-6 text-center">
    <p class="text-[32px] font-medium tracking-[-0.8px]">nothing here.</p>
    <a href="/" class="mt-3 text-[16px] tracking-[-0.4px] text-muted underline">
      go home
    </a>
    <div class="mt-8">
      <DownloadButton />
    </div>
    <div class="mt-16">
      <Footer />
    </div>
  </div>
</Layout>
